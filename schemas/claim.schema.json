{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "issuer_id", "statement", "as_of_date", "supporting_fact_ids", "counterevidence_fact_ids", "counterevidence_search_note", "confidence", "falsification_condition"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "claim_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "supporting_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counterevidence_fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counterevidence_search_note": {"type": ["string", "null"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "falsification_condition": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"counterevidence_fact_ids": {"maxItems": 0}}, "required": ["counterevidence_fact_ids"]},
      "then": {"properties": {"counterevidence_search_note": {"type": "string", "minLength": 1}}}
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/analytical-claim-review-decision.schema.json",
  "title": "AnalyticalClaimReviewDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "issuer_id", "candidate_id", "candidate_fingerprint", "evidence_graph_sha256", "decision", "output_claim_id", "reviewer_id", "reviewed_at", "rationale", "issues"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_graph_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["confirmed", "blocked", "rejected"]},
    "output_claim_id": {"type": ["string", "null"], "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1},
    "issues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "confirmed"}}}, "then": {"properties": {"output_claim_id": {"type": "string"}}}},
    {"if": {"properties": {"decision": {"enum": ["blocked", "rejected"]}}}, "then": {"properties": {"output_claim_id": {"type": "null"}, "issues": {"minItems": 1}}}}
  ]
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/footnote-review.schema.json",
  "title":"FootnoteReview","type":"object","additionalProperties":false,
  "required":["schema_version","review_id","issuer_id","fiscal_period_id","topic_code","dynamic_topic_label","status","source_document_ids","candidate_ids","fact_ids","claim_ids","calculation_result_ids","missing_evidence","counterevidence_search_note"],
  "properties":{"schema_version":{"const":"1.0.0"},"review_id":{"type":"string","minLength":1},"issuer_id":{"type":"string","minLength":1},"fiscal_period_id":{"type":"string","minLength":1},"topic_code":{"enum":["revenue_contract_balances","sbc","leases","income_taxes","pensions_postretirement","goodwill_intangibles_impairment","debt_liquidity_covenants","contingencies_litigation","acquisitions_divestitures","restructuring_exit","related_parties","commitments_guarantees_off_balance_sheet","supplier_finance","vie","fair_value_derivatives_hedging","dynamic"]},"dynamic_topic_label":{"type":["string","null"],"minLength":1},"status":{"enum":["reviewed","not_disclosed","not_applicable","blocked"]},"source_document_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"candidate_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"fact_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"claim_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"calculation_result_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"missing_evidence":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"counterevidence_search_note":{"type":"string","minLength":1}},
  "allOf":[{"if":{"properties":{"topic_code":{"const":"dynamic"}}},"then":{"properties":{"dynamic_topic_label":{"type":"string"}}},"else":{"properties":{"dynamic_topic_label":{"type":"null"}}}},{"if":{"properties":{"status":{"const":"blocked"}}},"then":{"properties":{"missing_evidence":{"minItems":1}}}}]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/score.schema.json",
  "title": "Score",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "score_id", "issuer_id", "extension_label", "framework", "component", "score", "max_score", "rationale", "fact_ids", "claim_ids", "calculation_result_ids", "confidence", "missing_evidence", "red_flags"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "score_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "extension_label": {"const": "PROJECT_EXTENSION"},
    "framework": {"type": "string", "minLength": 1},
    "component": {"type": "string", "minLength": 1},
    "score": {"type": "number", "minimum": 0},
    "max_score": {"type": "number", "exclusiveMinimum": 0},
    "rationale": {"type": "string", "minLength": 1},
    "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "calculation_result_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "missing_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "red_flags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

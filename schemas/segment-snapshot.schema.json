{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/segment-snapshot.schema.json",
  "title":"SegmentSnapshot","type":"object","additionalProperties":false,
  "required":["schema_version","snapshot_id","issuer_id","fiscal_period_id","status","segment_definition_ids","metric_assignments","consolidated_fact_ids","reconciliation_calculation_ids","display_precision","comparability_claim_ids","missing_evidence"],
  "properties":{"schema_version":{"const":"1.0.0"},"snapshot_id":{"type":"string","minLength":1},"issuer_id":{"type":"string","minLength":1},"fiscal_period_id":{"type":"string","minLength":1},"status":{"enum":["complete","partial","blocked"]},"segment_definition_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"metric_assignments":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["segment_id","fact_id","metric_role","presentation_order"],"properties":{"segment_id":{"type":"string","minLength":1},"fact_id":{"type":"string","minLength":1},"metric_role":{"enum":["revenue","profit_loss","assets","capex","depreciation","other"]},"presentation_order":{"type":"integer","minimum":0}}}},"consolidated_fact_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"reconciliation_calculation_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"display_precision":{"type":"object","additionalProperties":false,"required":["unit","currency","rounding_increment"],"properties":{"unit":{"type":"string","minLength":1},"currency":{"type":["string","null"],"pattern":"^[A-Z]{3}$"},"rounding_increment":{"type":"number","exclusiveMinimum":0}}},"comparability_claim_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"missing_evidence":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}},
  "allOf":[{"if":{"properties":{"status":{"const":"complete"}}},"then":{"properties":{"reconciliation_calculation_ids":{"minItems":1},"missing_evidence":{"maxItems":0}}}},{"if":{"properties":{"status":{"const":"blocked"}}},"then":{"properties":{"missing_evidence":{"minItems":1}}}}]

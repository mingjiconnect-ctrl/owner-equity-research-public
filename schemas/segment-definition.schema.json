{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/segment-definition.schema.json",
  "title":"SegmentDefinition","type":"object","additionalProperties":false,

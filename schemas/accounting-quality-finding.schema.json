{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/accounting-quality-finding.schema.json",
  "title":"AccountingQualityFinding","type":"object","additionalProperties":false,
  "required":["schema_version","finding_id","issuer_id","rule_id","rule_version","category","suggested_severity","final_severity","classification","status","fact_ids","calculation_result_ids","claim_ids","override_claim_id","missing_evidence"],
  "properties":{"schema_version":{"const":"1.0.0"},"finding_id":{"type":"string","minLength":1},"issuer_id":{"type":"string","minLength":1},"rule_id":{"type":"string","minLength":1},"rule_version":{"type":"string","minLength":1},"category":{"enum":["cash_conversion","accruals","sbc_dilution","restructuring_recurrence","goodwill_intangibles","impairment","tax_anomaly","lease_commitments","acquisition_reconciliation","segment_elimination","off_balance_sheet"]},"suggested_severity":{"enum":["informational","watch","red_flag"]},"final_severity":{"enum":["informational","watch","red_flag"]},"classification":{"enum":["temporary","structural","uncertain"]},"status":{"enum":["provisional","confirmed","cleared","blocked"]},"fact_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"calculation_result_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"claim_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"override_claim_id":{"type":["string","null"],"minLength":1},"missing_evidence":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}},
  "allOf":[{"if":{"properties":{"status":{"enum":["provisional","confirmed","cleared"]}}},"then":{"properties":{"claim_ids":{"minItems":1}}}},{"if":{"properties":{"status":{"const":"blocked"}}},"then":{"properties":{"missing_evidence":{"minItems":1}}}}]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/analytical-claim-candidate.schema.json",
  "title": "AnalyticalClaimCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "issuer_id", "as_of_date", "proposed_statement", "scope", "claim_role", "business_attribute_role", "business_component_type", "supporting_evidence_bindings", "counterevidence_bindings", "counterevidence_search_note", "proposed_confidence", "falsification_condition", "generation_method", "evidence_graph_sha256", "validation_status", "validation_issues"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "proposed_statement": {"type": "string", "minLength": 1},
    "scope": {"$ref": "#/$defs/scope"},
    "claim_role": {"enum": ["support", "counterevidence", "falsification", "not_applicable", "strengthening", "stable", "eroding"]},
    "business_attribute_role": {"anyOf": [{"$ref": "#/$defs/business_attribute_role"}, {"type": "null"}]},
    "business_component_type": {"anyOf": [{"$ref": "#/$defs/business_component_type"}, {"type": "null"}]},
    "supporting_evidence_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_binding"}},
    "counterevidence_bindings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_binding"}},
    "counterevidence_search_note": {"type": "string", "minLength": 1},
    "proposed_confidence": {"enum": ["high", "medium", "low"]},
    "falsification_condition": {"type": "string", "minLength": 1},
    "generation_method": {"enum": ["manual", "language_model"]},
    "evidence_graph_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validation_status": {"enum": ["ready", "blocked", "rejected"]},
    "validation_issues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [{"if": {"properties": {"validation_status": {"enum": ["blocked", "rejected"]}}}, "then": {"properties": {"validation_issues": {"minItems": 1}}}}],
  "$defs": {
    "business_attribute_role": {"enum": ["customer_identity", "purchase_reason", "revenue_formation", "pricing_method", "cost_structure", "capital_requirements", "distribution_method", "key_resources", "key_partners", "regulatory_dependencies", "demand_recurrence", "customer_concentration", "supplier_concentration"]},
    "business_component_type": {"enum": ["customer", "value_proposition", "revenue_model", "cost_structure", "distribution", "key_resource", "key_partner", "regulatory_dependency"]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["scope_type", "segment_definition_ids", "business_unit", "product_service", "geography", "customer_group", "channel"], "properties": {"scope_type": {"enum": ["issuer_wide", "segment_specific", "product_market"]}, "segment_definition_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "business_unit": {"type": ["string", "null"], "minLength": 1}, "product_service": {"type": ["string", "null"], "minLength": 1}, "geography": {"type": ["string", "null"], "minLength": 1}, "customer_group": {"type": ["string", "null"], "minLength": 1}, "channel": {"type": ["string", "null"], "minLength": 1}}},
    "evidence_binding": {"type": "object", "additionalProperties": false, "required": ["binding_id", "fact_id", "calculation_result_id", "context_observation_id"], "properties": {"binding_id": {"type": "string", "minLength": 1}, "fact_id": {"type": ["string", "null"], "minLength": 1}, "calculation_result_id": {"type": ["string", "null"], "minLength": 1}, "context_observation_id": {"type": ["string", "null"], "minLength": 1}}}
  }
}

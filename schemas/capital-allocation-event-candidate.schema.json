{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/capital-allocation-event-candidate.schema.json",
  "title": "CapitalAllocationEventCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "issuer_id", "as_of_date", "source_document_id", "source_locator", "excerpt_sha256", "proposed_event_type", "proposed_event_subtype", "proposed_scope", "proposed_identity_components", "proposed_announcement_date", "proposed_execution_period", "proposed_growth_classification", "proposed_source_role", "proposed_fact_bindings", "proposed_rationale_statement_ids", "proposed_related_commitment_ids", "potential_duplicate_candidate_ids", "supersedes_candidate_ids", "extraction_method", "validation_status", "validation_issues"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "source_document_id": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposed_event_type": {"$ref": "#/$defs/event_type"},
    "proposed_event_subtype": {"type": "string", "minLength": 1},
    "proposed_scope": {"$ref": "#/$defs/scope"},
    "proposed_identity_components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
    "proposed_announcement_date": {"type": "string", "format": "date"},
    "proposed_execution_period": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": ["string", "null"], "format": "date"}, "end": {"type": ["string", "null"], "format": "date"}}},
    "proposed_growth_classification": {"enum": ["organic", "inorganic", "mixed", "not_applicable", "unknown"]},
    "proposed_source_role": {"$ref": "#/$defs/source_role"},
    "proposed_fact_bindings": {"type": "array", "items": {"$ref": "#/$defs/fact_binding"}},
    "proposed_rationale_statement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proposed_related_commitment_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "potential_duplicate_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supersedes_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "extraction_method": {"enum": ["deterministic", "manual", "language_model"]},
    "validation_status": {"enum": ["ready", "blocked"]},
    "validation_issues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [{"if": {"properties": {"validation_status": {"const": "blocked"}}}, "then": {"properties": {"validation_issues": {"minItems": 1}}}}],
  "$defs": {
    "event_type": {"enum": ["organic_capex", "research_and_development", "acquisition", "divestiture", "buyback", "dividend", "debt_issuance", "debt_repayment", "equity_issuance", "stock_based_compensation", "pension_funding", "restructuring", "cash_accumulation"]},
    "source_role": {"enum": ["authorization", "announcement", "terms", "execution_update", "completion", "cancellation", "supersession", "financing_terms", "purchase_accounting", "periodic_recap", "rationale"]},
    "identity": {"type": "object", "additionalProperties": false, "required": ["role", "value"], "properties": {"role": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}},
    "fact_binding": {"type": "object", "additionalProperties": false, "required": ["binding_id", "role_id", "fact_id"], "properties": {"binding_id": {"type": "string", "minLength": 1}, "role_id": {"type": "string", "minLength": 1}, "fact_id": {"type": "string", "minLength": 1}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["scope_type", "segment_definition_ids", "business_unit", "product_service", "geography", "customer_group", "channel"], "properties": {"scope_type": {"enum": ["issuer_wide", "segment_specific", "business_unit", "product_market", "geography", "customer_group", "channel"]}, "segment_definition_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "business_unit": {"type": ["string", "null"]}, "product_service": {"type": ["string", "null"]}, "geography": {"type": ["string", "null"]}, "customer_group": {"type": ["string", "null"]}, "channel": {"type": ["string", "null"]}}}
  }
}

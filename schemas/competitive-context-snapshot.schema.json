{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/competitive-context-snapshot.schema.json",
  "title": "CompetitiveContextSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_snapshot_id", "issuer_id", "as_of_date", "status", "scope", "source_document_ids", "observation_ids", "competitor_selection_claim_ids", "coverage", "missing_evidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "context_snapshot_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "scope": {"$ref": "#/$defs/scope"},
    "source_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "competitor_selection_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "coverage": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/coverage"}},
    "missing_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "complete"}}}, "then": {"properties": {"missing_evidence": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "blocked"}}}, "then": {"properties": {"missing_evidence": {"minItems": 1}}}}
  ],
  "$defs": {
    "scope": {"type": "object", "additionalProperties": false, "required": ["scope_type", "segment_definition_ids", "business_unit", "product_service", "geography", "customer_group", "channel"], "properties": {"scope_type": {"enum": ["issuer_wide", "segment_specific", "product_market"]}, "segment_definition_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "business_unit": {"type": ["string", "null"], "minLength": 1}, "product_service": {"type": ["string", "null"], "minLength": 1}, "geography": {"type": ["string", "null"], "minLength": 1}, "customer_group": {"type": ["string", "null"], "minLength": 1}, "channel": {"type": ["string", "null"], "minLength": 1}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["topic", "status", "observation_ids", "claim_ids", "missing_evidence"], "properties": {"topic": {"enum": ["product_service", "customer_group", "geography", "channel", "competitor_set", "substitutes", "entry_barriers", "buyer_power", "supplier_power", "rivalry", "regulatory_change", "technology_change", "market_growth"]}, "status": {"enum": ["reviewed", "not_applicable", "blocked"]}, "observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "missing_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/schemas/filing-artifact.schema.json",
  "title": "FilingArtifact", "type": "object", "additionalProperties": false,
  "required": ["schema_version","artifact_id","issuer_id","source_document_id","cik","accession","form","filing_date","report_period","primary_document","source_url","raw_sha256","normalized_sha256","parser_id","parser_version","retrieved_at"],
  "properties": {
    "schema_version": {"const":"1.0.0"}, "artifact_id":{"type":"string","minLength":1}, "issuer_id":{"type":"string","minLength":1}, "source_document_id":{"type":"string","minLength":1},
    "cik":{"type":"string","pattern":"^[0-9]{10}$"}, "accession":{"type":"string","pattern":"^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}, "form":{"enum":["10-K","10-K/A","10-Q","10-Q/A"]},
    "filing_date":{"type":"string","format":"date"}, "report_period":{"type":"string","format":"date"}, "primary_document":{"type":"string","pattern":"^[^/]+\\.(html?|xhtml)$"},
    "source_url":{"type":"string","format":"uri","pattern":"^https://([a-z0-9-]+\\.)?sec\\.gov/"}, "raw_sha256":{"$ref":"#/$defs/sha"}, "normalized_sha256":{"$ref":"#/$defs/sha"},
    "parser_id":{"type":"string","minLength":1}, "parser_version":{"type":"string","minLength":1}, "retrieved_at":{"type":"string","format":"date-time"}
  }, "$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}

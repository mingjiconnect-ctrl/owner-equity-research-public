{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.owner-valuation/schemas/fact-ledger.schema.json",
  "title": "Immutable Fact Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_id", "valuation_date", "reporting_currency", "sources", "facts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "entity_id": {"type": "string", "minLength": 1},
    "valuation_date": {"type": "string", "format": "date"},
    "reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "published_date", "retrieved_at", "locator", "primary"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "published_date": {"type": "string", "format": "date"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "locator": {"type": "string", "minLength": 1},
          "url": {"type": ["string", "null"], "minLength": 1},
          "local_path": {"type": ["string", "null"], "minLength": 1},
          "primary": {"type": "boolean"}
        },
        "anyOf": [
          {"required": ["url"], "properties": {"url": {"type": "string", "minLength": 1}}},
          {"required": ["local_path"], "properties": {"local_path": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "concept", "value", "unit", "category", "source_id", "source_location", "as_of_date", "confidence", "raw", "parent_fact_ids", "derivation", "equity_bridge_role"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "concept": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "category": {"enum": ["operating", "financing", "nonoperating", "market_price", "market_reference", "share_count", "accounting", "evidence"]},
          "source_id": {"type": "string", "minLength": 1},
          "source_location": {"type": "string", "minLength": 1},
          "as_of_date": {"type": "string", "format": "date"},
          "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
          "period_start": {"type": ["string", "null"], "format": "date"},
          "period_end": {"type": ["string", "null"], "format": "date"},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]},
          "raw": {"type": "boolean"},
          "parent_fact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "derivation": {"type": ["string", "null"]},
          "equity_bridge_role": {"enum": [null, "nonoperating_asset", "debt", "debt_equivalent", "lease_liability", "unfunded_pension", "preferred_stock", "noncontrolling_interest", "option_or_dilution_claim", "other_senior_claim"]}
        },
        "allOf": [
          {
            "if": {"properties": {"raw": {"const": true}}},
            "then": {
              "properties": {
                "parent_fact_ids": {"maxItems": 0},
                "derivation": {"type": "null"}
              }
            },
            "else": {
              "properties": {
                "parent_fact_ids": {"minItems": 1},
                "derivation": {"type": "string", "minLength": 1}
              }
            }
          }
        ]
      }
    }
  }
}

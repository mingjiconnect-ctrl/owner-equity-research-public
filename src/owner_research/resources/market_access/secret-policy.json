{
  "policy_id": "market-access-secret-boundary",
  "policy_version": "1.0.0",
  "forbidden_field_fragments": ["credential", "secret", "token", "api_key", "apikey", "password", "bearer"],
  "forbidden_value_patterns": ["(?i)authorization\\s*:", "(?i)bearer\\s+", "(?i)(api[_-]?key|token|secret|password)=", "(?i)https?://[^/\\s]+@"],
  "serialized_surfaces": ["provider_registry", "request", "receipt", "result", "quarantine", "audit"],
  "raw_bytes_persisted": false
}

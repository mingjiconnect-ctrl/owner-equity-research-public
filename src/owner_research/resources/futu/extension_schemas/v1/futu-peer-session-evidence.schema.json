{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v1/futu-peer-session-evidence.schema.json",
  "title": "FutuPeerSessionEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "peer_session_id", "run_id", "issuer_id", "security_id", "price_blind_freeze", "price_blind_freeze_fingerprint", "security_identity_fingerprint", "authority_decision_fingerprint", "execution_bundle", "daily_close_adapter_fingerprint", "requests", "responses", "observations", "cas_objects", "peer_session_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "peer_session_id": {"type": "string", "pattern": "^futu-peer-session:[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "price_blind_freeze": {"$ref": "#/$defs/reference"},
    "price_blind_freeze_fingerprint": {"$ref": "#/$defs/sha256"},
    "security_identity_fingerprint": {"$ref": "#/$defs/sha256"},
    "authority_decision_fingerprint": {"$ref": "#/$defs/sha256"},
    "execution_bundle": {"$ref": "#/$defs/reference"},
    "daily_close_adapter_fingerprint": {"$ref": "#/$defs/sha256"},
    "requests": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/reference"}},
    "responses": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/reference"}},
    "observations": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/reference"}},
    "cas_objects": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/cas"}},
    "peer_session_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["object_id", "fingerprint"], "properties": {"object_id": {"type": "string", "minLength": 1}, "fingerprint": {"$ref": "#/$defs/sha256"}}},
    "cas": {"type": "object", "additionalProperties": false, "required": ["response_fingerprint", "raw_evidence_kind", "raw_plaintext_sha256", "encrypted_object_sha256", "cas_locator", "raw_byte_count"], "properties": {"response_fingerprint": {"$ref": "#/$defs/sha256"}, "raw_evidence_kind": {"const": "opend_protobuf_s2c_frame"}, "raw_plaintext_sha256": {"$ref": "#/$defs/sha256"}, "encrypted_object_sha256": {"$ref": "#/$defs/sha256"}, "cas_locator": {"type": "string", "pattern": "^cas://sha256/[a-f0-9]{64}$"}, "raw_byte_count": {"type": "integer", "minimum": 1}}}
  }
}

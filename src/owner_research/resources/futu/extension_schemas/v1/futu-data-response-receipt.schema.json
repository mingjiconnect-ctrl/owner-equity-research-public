{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v1/futu-data-response-receipt.schema.json",
  "title": "FutuDataResponseReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "response_id", "request_id", "request_fingerprint", "run_id", "serial_number", "retrieved_at", "ret_type", "err_code", "status", "qot_logined", "trd_logined", "pre_global_state_serial_number", "pre_global_state_trd_logined", "pre_global_state_request_fingerprint", "pre_global_state_response_fingerprint", "post_global_state_serial_number", "post_global_state_trd_logined", "post_global_state_request_fingerprint", "post_global_state_response_fingerprint", "raw_evidence_kind", "raw_plaintext_sha256", "encrypted_object_sha256", "cas_locator", "envelope_key_id", "raw_byte_count", "page_index", "next_key_sha256", "terminal", "parser_sha256", "response_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "response_id": {"type": "string", "pattern": "^futu-response:[a-f0-9]{64}$"},
    "request_id": {"type": "string", "pattern": "^futu-request:[a-f0-9]{64}$"},
    "request_fingerprint": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "minLength": 1},
    "serial_number": {"type": "integer", "minimum": 0},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "ret_type": {"type": "integer"},
    "err_code": {"type": "integer"},
    "status": {"enum": ["completed", "blocked", "quarantined"]},
    "qot_logined": {"type": "boolean"},
    "trd_logined": {"type": "boolean"},
    "pre_global_state_serial_number": {"type": "integer", "minimum": 0},
    "pre_global_state_trd_logined": {"type": "boolean"},
    "pre_global_state_request_fingerprint": {"$ref": "#/$defs/sha256"},
    "pre_global_state_response_fingerprint": {"$ref": "#/$defs/sha256"},
    "post_global_state_serial_number": {"type": "integer", "minimum": 0},
    "post_global_state_trd_logined": {"type": "boolean"},
    "post_global_state_request_fingerprint": {"$ref": "#/$defs/sha256"},
    "post_global_state_response_fingerprint": {"$ref": "#/$defs/sha256"},
    "raw_evidence_kind": {"const": "opend_protobuf_s2c_frame"},
    "raw_plaintext_sha256": {"$ref": "#/$defs/sha256"},
    "encrypted_object_sha256": {"$ref": "#/$defs/sha256"},
    "cas_locator": {"type": "string", "pattern": "^cas://sha256/[a-f0-9]{64}$"},
    "envelope_key_id": {"type": "string", "minLength": 1},
    "raw_byte_count": {"type": "integer", "minimum": 0, "maximum": 16777216},
    "page_index": {"type": "integer", "minimum": 0, "maximum": 63},
    "next_key_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "terminal": {"type": "boolean"},
    "parser_sha256": {"$ref": "#/$defs/sha256"},
    "response_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

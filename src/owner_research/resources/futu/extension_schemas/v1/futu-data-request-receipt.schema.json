{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v1/futu-data-request-receipt.schema.json",
  "title": "FutuDataRequestReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "run_id", "stage", "issuer_id", "security_id", "security_identity_fingerprint", "data_family", "protocol_id", "protocol_name", "parameters", "page_index", "previous_page_key_sha256", "data_cutoff_date", "expected_trading_date", "price_blind_freeze_fingerprint", "frozen_conclusion_receipt_id", "frozen_conclusion_fingerprint", "authority_decision_fingerprint", "request_started_at", "request_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^futu-request:[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["runtime_authority", "valuation_pre_price_verification", "market_reference", "peer_comparable_reference", "post_valuation_context"]},
    "issuer_id": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "security_identity_fingerprint": {"$ref": "#/$defs/sha256"},
    "data_family": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "integer", "minimum": 1},
    "protocol_name": {"type": "string", "pattern": "^(?:GetGlobalState|Qot_)"},
    "parameters": {"type": "object"},
    "page_index": {"type": "integer", "minimum": 0, "maximum": 63},
    "previous_page_key_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "data_cutoff_date": {"type": "string", "format": "date"},
    "expected_trading_date": {"type": ["string", "null"], "format": "date"},
    "price_blind_freeze_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "frozen_conclusion_receipt_id": {"type": ["string", "null"], "pattern": "^futu-conclusion-freeze:[a-f0-9]{64}$"},
    "frozen_conclusion_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "authority_decision_fingerprint": {"$ref": "#/$defs/sha256"},
    "request_started_at": {"type": "string", "format": "date-time"},
    "request_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

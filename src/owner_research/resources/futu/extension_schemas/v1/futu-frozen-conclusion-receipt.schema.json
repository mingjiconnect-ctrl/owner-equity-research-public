{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v1/futu-frozen-conclusion-receipt.schema.json",
  "title": "FutuFrozenConclusionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "issuer_id",
    "security_id",
    "composite_valuation",
    "owner_scorecard",
    "conclusion_frozen_at",
    "receipt_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^futu-conclusion-freeze:[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "composite_valuation": {"$ref": "#/$defs/reference"},
    "owner_scorecard": {"$ref": "#/$defs/reference"},
    "conclusion_frozen_at": {"type": "string", "format": "date-time"},
    "receipt_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "fingerprint"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

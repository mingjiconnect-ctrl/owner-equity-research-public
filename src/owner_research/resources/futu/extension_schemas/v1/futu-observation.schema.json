{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v1/futu-observation.schema.json",
  "title": "FutuObservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "issuer_id", "security_id", "data_family", "field_id", "canonical_concept", "period", "qualifiers", "value_type", "value", "unit", "currency", "binary64_hex", "exact_binary64_decimal", "response_fingerprint", "retrieved_at", "point_in_time_status", "source_role", "use_scope", "comparison_eligible", "observation_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"type": "string", "pattern": "^futu-observation:[a-f0-9]{64}$"},
    "issuer_id": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "data_family": {"type": "string", "minLength": 1},
    "field_id": {"type": "string", "minLength": 1},
    "canonical_concept": {"type": ["string", "null"]},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": ["string", "null"], "format": "date"},
        "end": {"type": ["string", "null"], "format": "date"}
      }
    },
    "qualifiers": {"type": "object"},
    "value_type": {"enum": ["number", "text", "boolean", "null"]},
    "value": {"type": ["string", "boolean", "null"]},
    "unit": {"type": ["string", "null"]},
    "currency": {"type": ["string", "null"]},
    "binary64_hex": {"type": ["string", "null"], "pattern": "^[a-f0-9]{16}$"},
    "exact_binary64_decimal": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},
    "response_fingerprint": {"$ref": "#/$defs/sha256"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "point_in_time_status": {"enum": ["point_in_time", "current_snapshot", "not_point_in_time"]},
    "source_role": {"enum": ["governed_broker_vendor", "vendor_secondary"]},
    "use_scope": {"enum": ["runtime_authority", "valuation_pre_price_verification", "market_reference", "peer_comparable_reference", "post_valuation_context"]},
    "comparison_eligible": {"type": "boolean"},
    "observation_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v1/futu-session-publication-manifest.schema.json",
  "title": "FutuSessionPublicationManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "session_id", "session_fingerprint", "run_id", "issuer_id", "security_id", "status", "finalized_at", "authority_decision_fingerprint", "authority_receipts", "runtime_authorization_fingerprint", "runtime_receipt_fingerprint", "attested_finalization_fingerprint", "sidecar_boot_attestation", "sidecar_execution_attestation", "contract_graph_fingerprint", "market_execution_evidence", "peer_evidence_set", "frozen_conclusion", "execution_bundles", "peer_sessions", "requests", "responses", "observations", "official_operands", "cross_checks", "cas_objects", "global_state_guards", "manifest_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^futu-session-publication:[a-f0-9]{64}$"},
    "session_id": {"type": "string", "pattern": "^futu-session:[a-f0-9]{64}$"},
    "session_fingerprint": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "status": {"const": "complete"},
    "finalized_at": {"type": "string", "format": "date-time"},
    "authority_decision_fingerprint": {"$ref": "#/$defs/sha256"},
    "authority_receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal", "account", "supply_chain", "security_identity"],
      "properties": {
        "legal": {"$ref": "#/$defs/sha256"},
        "account": {"$ref": "#/$defs/sha256"},
        "supply_chain": {"$ref": "#/$defs/sha256"},
        "security_identity": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_authorization_fingerprint": {"$ref": "#/$defs/sha256"},
    "runtime_receipt_fingerprint": {"$ref": "#/$defs/sha256"},
    "attested_finalization_fingerprint": {"$ref": "#/$defs/sha256"},
    "sidecar_boot_attestation": {"$ref": "#/$defs/reference"},
    "sidecar_execution_attestation": {"$ref": "#/$defs/reference"},
    "contract_graph_fingerprint": {"$ref": "#/$defs/sha256"},
    "market_execution_evidence": {"$ref": "#/$defs/reference"},
    "peer_evidence_set": {"$ref": "#/$defs/reference"},
    "frozen_conclusion": {"$ref": "#/$defs/reference"},
    "execution_bundles": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/reference"}},
    "peer_sessions": {"type": "array", "minItems": 5, "maxItems": 15, "items": {"$ref": "#/$defs/reference"}},
    "requests": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "responses": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "official_operands": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "cross_checks": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "cas_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["response_fingerprint", "raw_evidence_kind", "raw_plaintext_sha256", "encrypted_object_sha256", "cas_locator", "raw_byte_count"],
        "properties": {
          "response_fingerprint": {"$ref": "#/$defs/sha256"},
          "raw_evidence_kind": {"const": "opend_protobuf_s2c_frame"},
          "raw_plaintext_sha256": {"$ref": "#/$defs/sha256"},
          "encrypted_object_sha256": {"$ref": "#/$defs/sha256"},
          "cas_locator": {"type": "string", "pattern": "^cas://sha256/[a-f0-9]{64}$"},
          "raw_byte_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "global_state_guards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkpoint", "serial_number", "request_fingerprint", "response_fingerprint", "qot_logined", "trd_logined"],
        "properties": {
          "checkpoint": {"enum": ["startup", "pre_request", "post_request", "pre_shutdown"]},
          "serial_number": {"type": "integer", "minimum": 0},
          "request_fingerprint": {"$ref": "#/$defs/sha256"},
          "response_fingerprint": {"$ref": "#/$defs/sha256"},
          "qot_logined": {"type": "boolean"},
          "trd_logined": {"type": "boolean"}
        }
      }
    },
    "manifest_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "fingerprint"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

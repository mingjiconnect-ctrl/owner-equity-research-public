{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v1/futu-account-entitlement-receipt.schema.json",
  "title": "FutuAccountEntitlementReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "run_id", "policy_sha256", "component_lock_sha256", "account_scope_sha256", "observed_at", "global_state_response_fingerprint", "qot_logined", "trd_logined", "entitlements", "delay_class", "promotion_status", "quota_remaining", "protocol_version", "challenge_nonce", "issued_at", "expires_at", "signature_algorithm", "signer_key_id", "signature_hex"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^futu-account:[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "component_lock_sha256": {"$ref": "#/$defs/sha256"},
    "account_scope_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at": {"type": "string", "format": "date-time"},
    "global_state_response_fingerprint": {"$ref": "#/$defs/sha256"},
    "qot_logined": {"type": "boolean"},
    "trd_logined": {"type": "boolean"},
    "entitlements": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["granted", "denied", "unknown"]}},
    "delay_class": {"enum": ["real_time", "delayed", "unknown"]},
    "promotion_status": {"enum": ["normal", "promotional", "unknown"]},
    "quota_remaining": {"type": "integer", "minimum": 0},
    "protocol_version": {"type": "string", "minLength": 1},
    "challenge_nonce": {"$ref": "#/$defs/sha256"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature_algorithm": {"const": "ed25519"},
    "signer_key_id": {"type": "string", "minLength": 1},
    "signature_hex": {"type": "string", "pattern": "^[a-f0-9]{128}$"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

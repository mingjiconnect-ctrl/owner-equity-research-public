{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v1/futu-evidence-bundle.schema.json",
  "title": "FutuEvidenceBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "run_id", "issuer_id", "security_id", "stage", "status", "authority_decision_fingerprint", "requests", "responses", "observations", "cross_checks", "issues", "bundle_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "pattern": "^futu-bundle:[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["valuation_pre_price_verification", "market_reference", "peer_comparable_reference", "post_valuation_context"]},
    "status": {"enum": ["complete", "partial", "blocked", "quarantined"]},
    "authority_decision_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "requests": {"$ref": "#/$defs/references"},
    "responses": {"$ref": "#/$defs/references"},
    "observations": {"$ref": "#/$defs/references"},
    "cross_checks": {"$ref": "#/$defs/references"},
    "issues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "bundle_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "fingerprint"],
        "properties": {
          "object_id": {"type": "string", "minLength": 1},
          "fingerprint": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v1/futu-security-identity-receipt.schema.json",
  "title": "FutuSecurityIdentityReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "policy_sha256", "component_lock_sha256", "issuer_id", "cik", "security_id", "ticker", "mic", "currency", "share_class", "vendor_market", "vendor_code", "vendor_security_id", "vendor_security_type", "vendor_exchange_type", "effective_from", "effective_to", "official_evidence_fingerprint", "static_response_fingerprint", "reviewer_id", "issued_at", "signature_algorithm", "signer_key_id", "signature_hex"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^futu-security:[a-f0-9]{64}$"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "component_lock_sha256": {"$ref": "#/$defs/sha256"},
    "issuer_id": {"type": "string", "minLength": 1},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "security_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
    "mic": {"enum": ["XNAS", "XNYS"]},
    "currency": {"const": "USD"},
    "share_class": {"const": "common"},
    "vendor_market": {"const": "US"},
    "vendor_code": {"type": "string", "pattern": "^US\\.[A-Z][A-Z0-9.-]{0,9}$"},
    "vendor_security_id": {"type": "string", "minLength": 1},
    "vendor_security_type": {"type": "string", "minLength": 1},
    "vendor_exchange_type": {"type": "string", "minLength": 1},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {"type": ["string", "null"], "format": "date"},
    "official_evidence_fingerprint": {"$ref": "#/$defs/sha256"},
    "static_response_fingerprint": {"$ref": "#/$defs/sha256"},
    "reviewer_id": {"type": "string", "pattern": "^human:.+"},
    "issued_at": {"type": "string", "format": "date-time"},
    "signature_algorithm": {"const": "ed25519"},
    "signer_key_id": {"type": "string", "minLength": 1},
    "signature_hex": {"type": "string", "pattern": "^[a-f0-9]{128}$"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

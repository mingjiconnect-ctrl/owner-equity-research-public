{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/futu/v2/futu-supply-chain-receipt.schema.json",
  "title": "FutuSupplyChainReceipt — native macOS read-only profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "policy_sha256",
    "component_lock_sha256",
    "provider_id",
    "provider_version",
    "opend_version",
    "opend_server_version",
    "opend_server_build_no",
    "futu_api_version",
    "futu_api_distribution_sha256",
    "sdk_operation_registry_sha256",
    "protobuf_descriptor_set_sha256",
    "official_distribution_url",
    "distribution_sha256",
    "publisher_signature_status",
    "protocol_descriptor_sha256",
    "facade_sha256",
    "adapter_sha256",
    "parser_sha256",
    "vm_image_sha256",
    "sbom_sha256",
    "license_sha256",
    "daily_close_semantics_evidence_kind",
    "daily_close_semantics_evidence_sha256",
    "issued_at",
    "expires_at",
    "signature_algorithm",
    "signer_key_id",
    "signature_hex"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^futu-supply:[a-f0-9]{64}$"
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "component_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_id": {
      "const": "provider:futu-opend-sidecar"
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "opend_version": {
      "type": "string",
      "minLength": 1
    },
    "opend_server_version": {
      "type": "integer",
      "minimum": 1
    },
    "opend_server_build_no": {
      "type": "integer",
      "minimum": 1
    },
    "futu_api_version": {
      "const": "10.10.7008"
    },
    "futu_api_distribution_sha256": {
      "const": "3c607c7dce02a3a2b308f3424420277a360d7b3a4ba4508b39eaa4ff11271f98"
    },
    "sdk_operation_registry_sha256": {
      "const": "48be8aa86fd9c5fc5b5a3b201939c0bd4386b23dbe408d9f30a8e190ce3bbc4a"
    },
    "protobuf_descriptor_set_sha256": {
      "const": "c2b13581ef9acdbe2b9a95da26b95d6321058f7beb27b56fef90908519e312f8"
    },
    "official_distribution_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "distribution_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "publisher_signature_status": {
      "enum": [
        "verified",
        "documented_absence"
      ]
    },
    "protocol_descriptor_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "facade_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "adapter_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "parser_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "vm_image_sha256": {
      "type": "null",
      "description": "No virtual-machine image exists in the native macOS profile."
    },
    "sbom_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "license_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "daily_close_semantics_evidence_kind": {
      "enum": [
        "pinned_opend_proto_canary",
        "written_authority",
        "none"
      ]
    },
    "daily_close_semantics_evidence_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_algorithm": {
      "const": "ed25519"
    },
    "signer_key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$comment": "Version 2 is the user-authorized native macOS sidecar profile. No VM is claimed. Existing version-1 schema bytes and Linux semantics remain unchanged."
}

  "architectural_invariants": [
    "ResearchBundle remains price-blind and is never mutated by Phase 5.",
    "Compilation requires the strictly reloaded Bundle and RunManifest plus the matching complete ContractGraph.",
    "The price-blind artifact is not a valuation-request because the pinned Penman request requires market_equity_value_fact_id.",
    "All valuation mathematics is executed only by the pinned owner-valuation-kernel.",
    "McKinsey and Penman readiness and outputs remain separate and are never averaged.",
    "The first Phase 5 release blocks model facts whose currency differs from the kernel reporting currency."
  ],
  "strategies": [
    {
      "strategy_id": "assumption-map",
      "owner_phase": "5D",
      "disposition": "human_review_required",
      "rule": "Only a confirmed ValuationAssumptionCandidate and matching human ReviewDecision compile to a controlled kernel assumption; Research Assumption never maps directly."
    },
    {
      "strategy_id": "accounting-controls",
      "owner_phase": "5C",
      "disposition": "deterministic_mapping",
      "rule": "Compile aligned balance-sheet and clean-surplus fact references plus evidence-backed accounting-quality issues; missing disclosure cannot become zero."
    },
    {
      "strategy_id": "equity-bridge",
      "owner_phase": "5C",
      "disposition": "reviewed_mapping",
      "rule": "Compile all nine kernel bridge roles as modeled, explicitly_absent, not_applicable, or unresolved with official Fact evidence and double-count protection."
    },
    {
      "strategy_id": "fact-map",
      "owner_phase": "5B",
      "disposition": "registered_mapping",
      "rule": "Map only cutoff-safe numeric high/medium-confidence same-issuer Facts or eligible assumption-free CalculationResults through exact concept, unit, period, category, lineage, and bridge-role registries."
    },
    {
      "strategy_id": "kernel-output-preservation",
      "owner_phase": "5E",
      "disposition": "kernel_generated_only",
      "rule": "The pinned kernel alone generates every required result field; Phase 5 validates schema and fingerprints and archives the canonical payload without recalculation or rewriting."
    },
    {
      "strategy_id": "ledger-envelope",
      "owner_phase": "5B",
      "disposition": "deterministic_mapping",
      "rule": "Bind issuer, cutoff valuation date, one reporting currency, registered sources, and mapped Facts; reject foreign-currency model inputs under kernel rc.1."
    },
    {
      "strategy_id": "mckinsey-assumptions",
      "owner_phase": "5D",
      "disposition": "human_review_required",
      "rule": "Compile exactly black_swan, bear, base, and bull on one explicit timeline, including revenue, NOPAT, invested capital, WACC, terminal growth, terminal margin, ROIC, RONIC, and tolerance."
    },
    {
      "strategy_id": "method-views",
      "owner_phase": "5C",
      "disposition": "deterministic_mapping",
      "rule": "Compile only evidence-backed derived adjustment amounts, allowed targets, distinct roots, explicit groups, and separate McKinsey/Penman views with no market lineage."
    },
    {
      "strategy_id": "penman-request-assembly",
      "owner_phase": "5E",
      "disposition": "two_stage_assembly",
      "rule": "Freeze all nonmarket Penman assumptions in 5D, then add only the governed market-equity Fact reference in 5E before complete request validation."
    },
    {
      "strategy_id": "readiness-routing",
      "owner_phase": "5B",
      "disposition": "reviewed_mapping",
      "rule": "Derive company classification and six routing assessments from real eligible Facts, with independent McKinsey/Penman readiness and no fabricated numeric flags."
    },
    {
      "strategy_id": "request-assembly",
      "owner_phase": "5E",
      "disposition": "deterministic_compilation",
      "rule": "Assemble the first complete valuation request only after protected price-blind hashes and MarketReferenceSnapshot validate against the pinned component lock."
    },
    {
      "strategy_id": "source-map",
      "owner_phase": "5B",
      "disposition": "registered_mapping",
      "rule": "Map only primary_regulatory and company_primary documents; derive source identity metadata from a controlled registry, preserve exact Fact locator, and bind research content hash in the handoff and document locator."
    }
  ],

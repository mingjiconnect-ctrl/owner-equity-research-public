{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/owner-scorecard.schema.json",
  "title": "OwnerScorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scorecard_id", "extension_label", "issuer_id", "as_of_date", "status",
    "research_bundle_fingerprint", "composite_valuation_fingerprint", "lens_scores",
    "overall_score", "confidence_percent", "recommendation", "current_intrinsic_value",
    "market_price", "margin_of_safety",
    "twelve_month_upside", "critical_red_flags", "issue_codes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scorecard_id": {"type": "string", "pattern": "^owner-scorecard:.+:[a-f0-9]{24}$"},
    "extension_label": {"const": "PROJECT_EXTENSION_OWNER_SCORECARD_V1"},
    "issuer_id": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "research_bundle_fingerprint": {"$ref": "#/$defs/sha256"},
    "composite_valuation_fingerprint": {"$ref": "#/$defs/sha256"},
    "lens_scores": {"$ref": "#/$defs/lensScores"},
    "overall_score": {"anyOf": [{"$ref": "#/$defs/score100"}, {"type": "null"}]},
    "confidence_percent": {"anyOf": [{"$ref": "#/$defs/score100"}, {"type": "null"}]},
    "recommendation": {"enum": ["重点关注", "关注", "观察", "回避", "无法评级"]},
    "current_intrinsic_value": {"anyOf": [{"$ref": "#/$defs/positiveDecimal"}, {"type": "null"}]},
    "market_price": {"$ref": "#/$defs/positiveDecimal"},
    "margin_of_safety": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "twelve_month_upside": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "critical_red_flags": {"type": "array", "items": {"$ref": "#/$defs/criticalRedFlag"}},
    "issue_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {
        "properties": {
          "lens_scores": {"items": {"properties": {"status": {"const": "complete"}}}},
          "overall_score": {"$ref": "#/$defs/score100"},
          "confidence_percent": {"$ref": "#/$defs/score100"},
          "recommendation": {"enum": ["重点关注", "关注", "观察", "回避"]},
          "issue_codes": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "partial"}}, "required": ["status"]},
      "then": {
        "properties": {
          "lens_scores": {
            "items": {"properties": {"status": {"enum": ["complete", "partial"]}}},
            "contains": {"properties": {"status": {"const": "partial"}}},
            "minContains": 1
          },
          "overall_score": {"type": "null"},
          "confidence_percent": {"type": "null"},
          "recommendation": {"const": "无法评级"},
          "issue_codes": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
      "then": {
        "properties": {
          "lens_scores": {
            "contains": {"properties": {"status": {"enum": ["partial", "blocked"]}}},
            "minContains": 1
          },
          "overall_score": {"type": "null"},
          "confidence_percent": {"type": "null"},
          "recommendation": {"const": "无法评级"},
          "issue_codes": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "positiveDecimal": {"type": "string", "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"},
    "score100": {"type": "string", "pattern": "^(?:(?:0|[1-9][0-9]?)(?:\\.[0-9]+)?|100(?:\\.0+)?)$"},
    "evidenceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["object_type", "object_id", "fingerprint"],
      "properties": {
        "object_type": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "redFlag": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "rationale", "evidence_bindings"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["warning", "critical", "permanent_loss"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceBinding"}}
      }
    },
    "criticalRedFlag": {
      "allOf": [
        {"$ref": "#/$defs/redFlag"},
        {"properties": {"severity": {"enum": ["critical", "permanent_loss"]}}}
      ]
    },
    "lensScore": {
      "type": "object", "additionalProperties": false,
      "required": ["lens", "score_id", "score_fingerprint", "status", "total_score", "confidence_percent"],
      "properties": {
        "lens": {"enum": ["graham", "buffett", "munger", "duan_yongping"]},
        "score_id": {"type": "string", "minLength": 1},
        "score_fingerprint": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["complete", "partial", "blocked"]},
        "total_score": {"anyOf": [{"$ref": "#/$defs/score100"}, {"type": "null"}]},
        "confidence_percent": {"anyOf": [{"$ref": "#/$defs/score100"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
          "then": {
            "properties": {
              "total_score": {"$ref": "#/$defs/score100"},
              "confidence_percent": {"$ref": "#/$defs/score100"}
            }
          },
          "else": {
            "properties": {
              "total_score": {"type": "null"},
              "confidence_percent": {"type": "null"}
            }
          }
        }
      ]
    },
    "lensScores": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/lensScore"},
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/lensScore"},
            {"properties": {
              "lens": {"const": "graham"},
              "score_id": {"pattern": "^score-v2:.+:graham:[a-f0-9]{24}$"}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/lensScore"},
            {"properties": {
              "lens": {"const": "buffett"},
              "score_id": {"pattern": "^score-v2:.+:buffett:[a-f0-9]{24}$"}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/lensScore"},
            {"properties": {
              "lens": {"const": "munger"},
              "score_id": {"pattern": "^score-v2:.+:munger:[a-f0-9]{24}$"}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/lensScore"},
            {"properties": {
              "lens": {"const": "duan_yongping"},
              "score_id": {"pattern": "^score-v2:.+:duan_yongping:[a-f0-9]{24}$"}
            }}
          ]
        }
      ]
    }
  }
}

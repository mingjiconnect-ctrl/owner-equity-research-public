{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/report-toolchain-authority.schema.json",
  "title": "ReportToolchainAuthorityRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "registry_id",
    "required_platform_targets",
    "authorities",
    "missing_platform_targets",
    "release_status",
    "registry_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "report-toolchain-authority-registry"},
    "registry_id": {
      "type": "string",
      "pattern": "^report-toolchain-authority-registry:[0-9a-f]{24}$"
    },
    "required_platform_targets": {
      "const": ["linux-x64", "macos-arm64"]
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "object"}
    },
    "missing_platform_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["linux-x64", "macos-arm64"]}
    },
    "release_status": {"enum": ["ready", "blocked"]},
    "registry_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

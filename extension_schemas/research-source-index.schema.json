{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mingjiconnect-ctrl/owner-equity-research/extension_schemas/research-source-index.schema.json",
  "title": "ResearchSourceIndex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "index_id", "issuer_id", "data_cutoff_date",
    "research_bundle_id", "research_bundle_fingerprint", "contract_graph_fingerprint",
    "source_count", "sources", "index_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "research-source-index"},
    "index_id": {"type": "string", "pattern": "^research-source-index:.+:[a-f0-9]{24}$"},
    "issuer_id": {"type": "string", "minLength": 1},
    "data_cutoff_date": {"type": "string", "format": "date"},
    "research_bundle_id": {"type": "string", "minLength": 1},
    "research_bundle_fingerprint": {"$ref": "#/$defs/sha256"},
    "contract_graph_fingerprint": {"$ref": "#/$defs/sha256"},
    "source_count": {"type": "integer", "minimum": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "index_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id", "document_fingerprint", "document_type", "source_url",
        "source_issuer_id", "source_scope", "content_sha256", "published_date",
        "retrieved_at", "authority_level", "locators"
      ],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "document_fingerprint": {"$ref": "#/$defs/sha256"},
        "document_type": {"type": "string", "minLength": 1},
        "source_issuer_id": {"type": "string", "minLength": 1},
        "source_scope": {"enum": ["target_issuer", "external_context"]},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "published_date": {"type": "string", "format": "date"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "authority_level": {"type": "string", "minLength": 1},
        "locators": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    }
  }
}
